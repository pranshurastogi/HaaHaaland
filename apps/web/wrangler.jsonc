{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "haahaaland-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "LOCAL_FALLBACK_ENABLED": "true",
    "RAILWAY_API_URL": "https://haahaaland-production.up.railway.app",
    "NEXT_PUBLIC_APP_URL": "https://haahaaland-web.pranshurastogi3196.workers.dev",
    "NEXT_PUBLIC_CONVEX_URL": "https://qualified-ram-378.convex.cloud",
    "NEXT_PUBLIC_POSTHOG_HOST": "https://us.i.posthog.com",
    "NEXT_PUBLIC_POSTHOG_KEY": "phc_qvMrZv8k5ERbPhUHRRdmNJRcTGP3cgXNfJ2W5oczazcW",
    "FEATURE_PROFILE_SCOUT": "true",
    "FEATURE_INSTAGRAM_INPUT": "true",
    "FEATURE_MANUAL_POSTS": "true",
    "FEATURE_CHALLENGES": "true",
    "FEATURE_LEADERBOARD": "true",
    "FEATURE_PRODUCT_XI": "false",
    "FEATURE_AUDIO": "false",
    "FEATURE_HERMES_VAR": "false",
    "FEATURE_PAYMENTS": "false",
  },
  "env": {
    "ci": {
      "name": "haahaaland-web-ci",
      "vars": { "LOCAL_FALLBACK_ENABLED": "true" },
    },
  },
}
